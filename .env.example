# Copy this file to .env on your host (or set these as real environment variables —
# the server reads process.env directly, it does not load .env files itself).

# ---- Supabase (PostgreSQL user store) ----
# Server-side only. Never expose these to the browser or commit real values.
# When both are set, the server stores users in the public.users table via the
# Supabase REST API; without them it falls back to the local JSON file (dev only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for every AI feature: syllabus analysis, Daily 10, AI tutor chat,
# root-cause insight, AI-generated lessons, AI-generated practice sets, and
# admin AI priorities. Without this, the app still runs — registration, login,
# the dashboard, and preferences all work — but AI-dependent actions return a
# clear "AI is not configured" error instead of silently faking a response.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5 if not set.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Comma-separated list of account emails that should see /admin-dashboard.
# Leave empty and nobody can access admin routes (they'll get a 403).
ADMIN_EMAILS=

# Optional. Defaults to 3000.
PORT=3000

# Optional. Set to "production" on your real deployment — this makes the session
# cookie "Secure" (HTTPS-only). Leave unset for local development over http://.
NODE_ENV=
